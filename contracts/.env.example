# Copy to .env (git-ignored) and fill in. Never commit a real key.

# Test network. Take the RPC URL and chain ID from Robinhood Chain's own docs.
RH_TESTNET_RPC=
RH_TESTNET_CHAIN_ID=
# Mainnet, chain 4663. Only after an audit.
RH_MAINNET_RPC=

# A throwaway key that holds only test ETH.
DEPLOYER_KEY=

# Leave empty on a test network to deploy MockToken / MockIdentity.
TOKEN=
IDENTITY=
# A Safe on mainnet. Defaults to the deployer on test networks.
ARBITER=
TREASURY=

# Parameters (token units and seconds). Defaults match docs/validators.md.
MIN_BOND=100000
MISS_PENALTY=5000
FRAUD_PENALTY=50000
CHALLENGE_BOND=10000
ACCEPT_WINDOW=86400
RESPONSE_WINDOW=172800
CHALLENGE_WINDOW=259200
UNBOND_DELAY=604800
VALIDITY=2592000
